# Clerk publishable key for the browser bundle.
#
# Public by design: it identifies the Clerk instance and ships inside the
# built JavaScript. Vite inlines VITE_-prefixed variables at build time, so
# this must be set wherever the build runs -- copy this file to .env.local for
# local development, and set the same variable on Vercel for the deploy.
VITE_CLERK_PUBLISHABLE_KEY=
