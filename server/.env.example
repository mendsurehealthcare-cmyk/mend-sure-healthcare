PORT=5000

# Get these from your Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the React app runs, so the API only accepts requests from it
CLIENT_ORIGIN=http://localhost:5173

# Sends an email to your team whenever a new patient enquiry comes in.
# Get a key at https://resend.com (free tier: 3,000 emails/month).
# Without this set, the app still works fine — new enquiries just get
# logged to the server console instead of emailed.
RESEND_API_KEY=
# The inbox that should receive new-enquiry alerts.
NOTIFY_TO_EMAIL=hello@mendsure.com
# The "from" address Resend sends as. Until you verify your own domain in
# Resend, you can only send from their sandbox address below, and only to
# your own Resend account email — verify a domain in the Resend dashboard
# before going live.
NOTIFY_FROM_EMAIL=Mend Sure <onboarding@resend.dev>
